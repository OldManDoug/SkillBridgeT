@page
@model SkillBridge.Web.Pages.Admin.Quizzes.IndexModel
@{
    ViewData["Title"] = "Quizzes";
}
<a asp-page="/JianYi/Admin/Index" class="breadcrumbs">← Administration</a>
<div class="page-head">
    <div>
        <p class="eyebrow">COURSE ASSESSMENTS</p>
        <h1>Quizzes</h1>
        <p>View course assessments and their publication status.</p>
    </div>
</div>
<!--FOR CREATE QUIZ will go to dedicated page -->
<button type="submit" asp-page="/Timothy/Admin/Quizzes/Create"> Create Quiz </button> 
@if (Model.Quizzes.Count == 0)
{
    <section class="card empty">
        <h2>No quizzes yet</h2>
        <p>Quizzes will appear here when they are added.</p>
    </section>
}
else
{
    <div class="card table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Quiz</th>
                    <th scope="col">Course</th>
                    <th scope="col">Questions</th>
                    <th scope="col">Pass Mark</th>
                    <th scope="col">Attempts</th>
                    <th scope="col">Status</th>
                    <th scope="col">Preview</th>
                </tr>
            </thead>
            <tbody>
        
                @foreach (var quiz in Model.Quizzes )
                {
                    //how to make the attempts however? 
                    <tr>
                        <td><span class="table-label">Quiz</span>@quiz.Title</td>
                        <td><span class="table-label">Course</span>@quiz.CourseTitle</td>
                        <td><span class="table-label">Questions</span>@quiz.QuestionCount</td>
                       <td><span class="table-label">Pass Mark </span>@quiz.PassPercentage</td>
                       <td><span class="table-label">Attempts</span></td> 
                        <td>
                            <span class="table-label">Status</span>
                            <span class="badge @(quiz.IsPublished ? "success" : "warning")">@(quiz.IsPublished ? "Published" : "Draft")</span>
                        </td>
                        <td class="actions">
                            <a asp-page="/Timothy/Quizzes/Start" asp-route-quizId="@quiz.Id" aria-label="Preview @quiz.Title">Preview</a>
                       <button type="button" class="edit-btn"  asp-page="/Timothy/Admin/Quizzes/Update">Edit</button>
                        <a asp-page="/Timothy/Admin/Quizzes/Index" 
                                   asp-page-handler="Delete" 
                                   asp-route-id="@quiz.Id" 
                                   class="todo-action-btn delete-btn" 
                                   onclick="return confirm('Are you sure you want to delete this quiz and questions?');"> 
                                    Delete 
                                </a> 
                        <button type="button" onclick="return">Delete</button>
                        
                        </td>
                    </tr>
                }
                
            </tbody>
        </table>
        
    </div>
    
}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script> 
 
<script> 
    $(document).ready(function () { 
        $(".edit-btn").click(function () { 
            //update the forms
            var id = $(this).data("id"); 
            var task = $(this).data("task"); 
            var completed = String($(this).data("completed")) 
                .toLowerCase() === "true"; 
            var dueDate = $(this).attr("data-due-date"); 
 
            $("#EditId").val(id); 
            $("#EditTask").val(task); 
            $("#EditCompleted").prop("checked", completed); 
            $("#EditDueDate").val(dueDate); 
 
            $("#editModal").show(); 
        }); 
 
        $("#closeModal").click(function () { 
            $("#editModal").hide(); 
        }); 
 
        $(window).click(function (event) { 
            if ($(event.target).is("#editModal")) { 
                $("#editModal").hide(); 
            } 
        }); 
        // for delete
    }); 
