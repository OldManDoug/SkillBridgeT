@page
@model SkillBridge.Web.Pages.Hamzah.Forum.IndexModel
@{
    ViewData["Title"] = "Community";
}
<div class="page-head">
    <div>
        <p class="eyebrow">LEARN BETTER, TOGETHER</p>
        <h1>A place to ask and share</h1>
        <p>Practical questions. Helpful conversations.</p>
    </div>
    <div class="actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Hamzah/Forum/Editor" class="btn primary">Start a discussion</a>
        }
        else
        {
            <a asp-page="/Account/Login" class="btn primary">Sign in to join the discussion</a>
        }
    </div>
</div>

@if (Model.Discussions.Count == 0)
{
    <section class="card empty">
        <h2>Our community is taking shape</h2>
        <p>There are no discussions yet. Be the first to start one.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Hamzah/Forum/Editor" class="btn primary">Start a discussion</a>
        }
    </section>
}
@foreach (var discussion in Model.Discussions)
{
    <article class="card section-space">
        <div class="card-body">
            <h2><a asp-page="/Hamzah/Forum/View" asp-route-id="@discussion.Id">@discussion.Title</a></h2>
            <p class="muted">
                @discussion.AuthorName · @discussion.ReplyCount @(discussion.ReplyCount == 1 ? "reply" : "replies") · active @discussion.UpdatedAt.ToString("dd MMM yyyy")
                @if (discussion.IsPinned)
                {
                    <span class="badge">Pinned</span>
                }
                @if (discussion.IsLocked)
                {
                    <span class="badge">Locked</span>
                }
            </p>
        </div>
    </article>
}